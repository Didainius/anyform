#!/usr/bin/env bash

# Enable strict mode to catch errors and undefined variables
set -euo pipefail

# Initialize variables to prevent unbound variable errors
TEMP_DIR="" # This will be set by mktemp -d later
REPO_ADDRESS=""
COMMIT_VERSION=""
IS_PR=false
PR_NUMBER=""

# Version
VERSION="v0.11.0"

# Initialize flag variables
PRINT_CONFIG=false
SILENT=false
OPENTOFU_ONLY=false

# Function to print error messages
print_error() {
    # Print error message to stderr
    # $1: The error message to display
    echo "Error: $1" >&2
}

# Function to cleanup temporary files
cleanup() {
    # Cleans up temporary resources when script exits
    # No arguments expected
    local exit_code=$?
    # Only remove TEMP_DIR if it was set and is a directory
    if [ -n "${TEMP_DIR:-}" ] && [ -d "$TEMP_DIR" ]; then
        rm -rf "$TEMP_DIR"
        TEMP_DIR="" # Reset TEMP_DIR after removal
    fi
    # Ensure trap handler is removed to prevent potential recursion on exit
    trap - EXIT INT TERM
    # Exit with the original exit code
    exit $exit_code
}

# Register cleanup handler
trap cleanup EXIT INT TERM

# --- Dependency Checks ---
# Check if essential dependencies are installed before proceeding
if ! command -v curl > /dev/null 2>&1; then
    print_error "curl is not installed. Please install curl to continue."
    exit 1
fi
# Check if git is installed and executable
if ! command -v git > /dev/null 2>&1; then
    print_error "git is not installed. Please install git and try again."
    exit 1
fi
# Check if go is installed and executable
if ! command -v go > /dev/null 2>&1; then
    print_error "Go is not installed. Please install Go and try again."
    exit 1
fi
# Removed unzip check as it's not used

# --- Versioning and Update Functions ---

# Function to check for latest version
check_latest_version() {
    # Fetches the latest version from GitHub releases
    # Returns the version tag or non-zero exit code on failure
    local latest_version
    # Use default empty string if curl fails or returns nothing
    latest_version=$(curl -s https://api.github.com/repos/Didainius/anyform/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || echo "")
    if [ -z "$latest_version" ] || ! [[ "$latest_version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        # Return non-zero status code on failure
        return 1
    fi
    echo "$latest_version"
    return 0
}

# Function to compare semantic versions
# Returns 1 if version1 > version2, 0 if equal, -1 if version1 < version2
compare_versions() {
    # Compares two semantic version strings (e.g. v1.2.3)
    # $1: First version to compare
    # $2: Second version to compare
    # Returns: 1 if $1 > $2, 0 if equal, -1 if $1 < $2
    local version1 version2
    local v1_major v1_minor v1_patch v2_major v2_minor v2_patch
    
    # Remove 'v' prefix
    version1=$(echo "$1" | sed 's/^v//')
    version2=$(echo "$2" | sed 's/^v//')
    
    if [ "$version1" = "$version2" ]; then
        echo 0
        return
    fi
    
    # Split versions into components
    IFS='.' read -r v1_major v1_minor v1_patch <<< "${version1}"
    IFS='.' read -r v2_major v2_minor v2_patch <<< "${version2}"
    
    # Extract numeric parts only (handle cases like "1.2.3-beta")
    v1_patch=$(echo "$v1_patch" | sed 's/[^0-9].*//')
    v2_patch=$(echo "$v2_patch" | sed 's/[^0-9].*//')
    
    # Convert empty or non-numeric values to 0
    v1_major=${v1_major:-0}; [[ ! "$v1_major" =~ ^[0-9]+$ ]] && v1_major=0
    v1_minor=${v1_minor:-0}; [[ ! "$v1_minor" =~ ^[0-9]+$ ]] && v1_minor=0
    v1_patch=${v1_patch:-0}; [[ ! "$v1_patch" =~ ^[0-9]+$ ]] && v1_patch=0
    v2_major=${v2_major:-0}; [[ ! "$v2_major" =~ ^[0-9]+$ ]] && v2_major=0
    v2_minor=${v2_minor:-0}; [[ ! "$v2_minor" =~ ^[0-9]+$ ]] && v2_minor=0
    v2_patch=${v2_patch:-0}; [[ ! "$v2_patch" =~ ^[0-9]+$ ]] && v2_patch=0
    
    # Perform comparisons
    if [ "$v1_major" -gt "$v2_major" ]; then echo 1
    elif [ "$v1_major" -lt "$v2_major" ]; then echo -1
    elif [ "$v1_minor" -gt "$v2_minor" ]; then echo 1
    elif [ "$v1_minor" -lt "$v2_minor" ]; then echo -1
    elif [ "$v1_patch" -gt "$v2_patch" ]; then echo 1
    elif [ "$v1_patch" -lt "$v2_patch" ]; then echo -1
    else echo 0
    fi
}

# Function to check if we have write permissions
check_write_permissions() {
    # Checks if we have appropriate permissions to write to a file or directory
    # $1: Target path to check
    # Returns: 0 if writable, 1 otherwise
    local target="$1"
    local target_dir
    target_dir=$(dirname "$target")
    
    # Check if target exists and is not writable OR target directory is not writable
    if { [ -f "$target" ] && [ ! -w "$target" ]; } || [ ! -w "$target_dir" ]; then
        print_error "Insufficient permissions to write to $target or its directory $target_dir"
        echo "Please try running with sudo: sudo anyform --self-update"
        return 1
    fi
    
    return 0
}

# Function to perform self-update
self_update() {
    # Updates the script itself to the latest available version
    # No arguments expected
    # Returns: Exits with 0 on success, non-zero otherwise
    local latest_version compare_result current_script temp_file
    
    latest_version=$(check_latest_version)
    if [ $? -ne 0 ]; then
        print_error "Failed to fetch latest version information"
        exit 1
    fi
    
    compare_result=$(compare_versions "$latest_version" "$VERSION")
    
    if [ "$compare_result" -eq 0 ]; then
        echo "Already running the latest version $VERSION"
        exit 0
    elif [ "$compare_result" -eq -1 ]; then
        print_error "Latest available version ($latest_version) is older than current version ($VERSION)"
        exit 1
    fi
    
    # Find current script location
    current_script="$(command -v anyform)" || current_script="$0"
    if [ -z "$current_script" ]; then
        print_error "Could not determine the location of the currently running script."
        exit 1
    fi
    # Resolve symlinks to get the actual script path
    current_script=$(readlink -f "$current_script" || realpath "$current_script" || echo "$current_script")

    # Check permissions before proceeding
    if ! check_write_permissions "$current_script"; then
        exit 1
    fi
    
    echo "Updating from $VERSION to $latest_version..."
    # Create a temporary file for the download
    temp_file=$(mktemp)
    # Ensure temp_file is removed on exit or error during this function
    trap 'rm -f "$temp_file"' RETURN INT TERM

    if curl -L "https://github.com/Didainius/anyform/releases/latest/download/anyform" -o "$temp_file"; then
        chmod +x "$temp_file"
        # Attempt to replace the current script with the downloaded one
        if mv "$temp_file" "$current_script"; then
            # Set proper permissions (readable and executable by all, writable only by owner)
            chmod 755 "$current_script"
            echo "Successfully updated to $latest_version"
            # Untrap the temporary file as it's been moved
            trap - RETURN INT TERM
        else
            # mv failed, temp_file still exists and will be removed by trap
            print_error "Failed to move updated script to $current_script"
            exit 1
        fi
    else
        # curl failed, temp_file still exists and will be removed by trap
        print_error "Failed to download update"
        exit 1
    fi
}

# Function to check if update is available
check_update() {
    # Checks if a newer version of the script is available
    # No arguments expected
    # Returns: Exits with 0 if up to date or update available, non-zero on error or warning
    local latest_version compare_result
    
    latest_version=$(check_latest_version)
    if [ $? -ne 0 ]; then
        print_error "Failed to fetch latest version information"
        exit 1
    fi
    
    compare_result=$(compare_versions "$latest_version" "$VERSION")
    
    if [ "$compare_result" -eq 0 ]; then
        echo "You are running the latest version $VERSION"
        exit 0
    elif [ "$compare_result" -eq -1 ]; then
        echo "Warning: Latest available version ($latest_version) is older than current version ($VERSION)"
        exit 1 # Exit with non-zero status for warning condition
    else
        echo "Update available: $VERSION -> $latest_version"
        echo "Run 'anyform --self-update' to update"
        exit 0
    fi
}

# --- Main Script Logic ---

# Function to print usage
print_usage() {
    # Prints usage instructions for the script
    # No arguments expected
    echo "Usage: $0 [--print-configuration | -p] [--version] [--self-update | -U] [--check-update] [--silent | -s] [--opentofu] <repository-address> [git-commit-version]"
    echo "Options:"
    echo "  --print-configuration, -p  Print the Terraform configuration block"
    echo "  --version                  Print version information"
    echo "  --self-update, -U          Update anyform to the latest version"
    echo "  --check-update             Check if a new version is available"
    echo "  --silent, -s               Run in silent mode (no output except errors)"
    echo "  --opentofu                 Install for OpenTofu only (skip Terraform)"
    echo "  -h, --help                 Show this help message"
    echo "Note: Repository address can be:"
    echo "  - Repository URL: https://github.com/<organization>/terraform-provider-<name>"
    echo "  - Pull Request URL: https://github.com/<organization>/terraform-provider-<name>/pull/<number>"
    echo "If git-commit-version is not specified, the latest commit from default branch or PR will be used"
}

# Function to print messages unless in silent mode
print_message() {
    # Prints a message to stdout unless silent mode is enabled
    # $1: Message to print
    if [ "$SILENT" = false ]; then
        echo "$1"
    fi
}

# Check if any arguments are provided
if [ "$#" -eq 0 ]; then
    print_usage
    exit 1
fi

# Parse arguments
while [ "$#" -gt 0 ]; do
    case "$1" in
        --print-configuration|-p)
            PRINT_CONFIG=true
            shift
            ;;
        --version)
            echo "AnyForm version $VERSION"
            exit 0
            ;;
        --self-update|-U)
            self_update
            exit 0
            ;;
        --check-update)
            check_update
            exit 0
            ;;
        --silent|-s)
            SILENT=true
            shift
            ;;
        --opentofu)
            OPENTOFU_ONLY=true
            shift
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            if [ -z "$REPO_ADDRESS" ]; then
                REPO_ADDRESS=$1
            elif [ -z "$COMMIT_VERSION" ]; then
                COMMIT_VERSION=$1
            else
                print_usage
                exit 1
            fi
            shift
            ;;
    esac
done

# Validate required arguments
if [ -z "$REPO_ADDRESS" ]; then
    print_error "Repository address is required."
    print_usage
    exit 1
fi

# Extract provider information and organization from repository address
GITHUB_PATTERN="^https://github.com/([^/]+)/" # Added ^ anchor
PROVIDER_PATTERN="terraform-provider-([^/]+)"
PR_PATTERN="/pull/([0-9]+)" # Simplified PR pattern check after main URL check

# Check if it's a PR URL and extract PR number
IS_PR=false
PR_NUMBER=""
if [[ $REPO_ADDRESS =~ $PR_PATTERN ]]; then
    IS_PR=true
    PR_NUMBER="${BASH_REMATCH[1]}"
    # Remove the PR part from the URL to get the base repo address
    REPO_ADDRESS=$(echo "$REPO_ADDRESS" | sed -E "s|/pull/[0-9]+/?$||")
fi

# Extract organization from GitHub URL
if [[ $REPO_ADDRESS =~ $GITHUB_PATTERN ]]; then
    ORGANIZATION="${BASH_REMATCH[1]}"
else
    print_error "Unable to extract organization from repository address: $REPO_ADDRESS"
    echo "Repository address must start with: https://github.com/<organization>/..."
    exit 1
fi

# Extract provider information
if [[ $REPO_ADDRESS =~ $PROVIDER_PATTERN ]]; then
    PROVIDER_NAME="terraform-provider-${BASH_REMATCH[1]}"
    PROVIDER_TYPE="${BASH_REMATCH[1]}"
else
    print_error "Unable to extract provider name from repository address: $REPO_ADDRESS"
    echo "Repository name must contain: terraform-provider-<name>"
    exit 1
fi

print_message "Organization: $ORGANIZATION"
print_message "Provider Name: $PROVIDER_NAME"
print_message "Provider Type: $PROVIDER_TYPE"
if [ "$IS_PR" = true ]; then
    print_message "Pull Request: #$PR_NUMBER"
fi

# Print the provided arguments
print_message "Repository Address: $REPO_ADDRESS"
if [ -n "$COMMIT_VERSION" ]; then
    print_message "Git Commit Version: $COMMIT_VERSION"
fi

# Create secure temporary directory for cloning
# TEMP_DIR is cleaned up by the main trap handler
TEMP_DIR=$(mktemp -d -t anyform_clone_XXXXXX)
print_message "Cloning repository into temporary directory: $TEMP_DIR"

# Clone repository
if [ "$SILENT" = true ]; then
    git clone --quiet "$REPO_ADDRESS" "$TEMP_DIR" || {
        print_error "Failed to clone repository from $REPO_ADDRESS"
        exit 1
    }
else
    git clone "$REPO_ADDRESS" "$TEMP_DIR" || {
        print_error "Failed to clone repository from $REPO_ADDRESS"
        exit 1
    }
fi

# Change to temp directory
cd "$TEMP_DIR" || {
    print_error "Failed to change to temporary directory: $TEMP_DIR"
    exit 1
}

# Fetch updates
print_message "Fetching updates..."
if [ "$SILENT" = true ]; then
    git fetch --all --tags --quiet || {
        print_error "Failed to fetch updates from repository"
        exit 1
    }
else
    git fetch --all --tags || {
        print_error "Failed to fetch updates from repository"
        exit 1
    }
fi

# Handle PR checkout
if [ "$IS_PR" = true ]; then
    print_message "Fetching Pull Request #$PR_NUMBER"
    PR_BRANCH_LOCAL="pr-$PR_NUMBER"
    if [ "$SILENT" = true ]; then
        git fetch --quiet origin "pull/$PR_NUMBER/head:$PR_BRANCH_LOCAL"
    else
        git fetch origin "pull/$PR_NUMBER/head:$PR_BRANCH_LOCAL"
    fi
    if [ $? -ne 0 ]; then
        print_error "Failed to fetch PR #$PR_NUMBER"
        exit 1
    fi
    # If no specific commit version provided, use the PR branch head
    if [ -z "$COMMIT_VERSION" ]; then
        COMMIT_VERSION="$PR_BRANCH_LOCAL"
        print_message "Using HEAD of PR #$PR_NUMBER ($COMMIT_VERSION)"
    fi
fi

# Determine commit version if not specified
if [ -z "$COMMIT_VERSION" ]; then
    print_message "No commit version specified, determining latest commit from default branch..."
    # Get default branch name
    DEFAULT_BRANCH=$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5)
    if [ -z "$DEFAULT_BRANCH" ]; then
        print_error "Could not determine the default branch for the repository."
        exit 1
    fi
    print_message "Default branch identified as: $DEFAULT_BRANCH"
    # Ensure the default branch is up-to-date locally
    if [ "$SILENT" = true ]; then
        git fetch --quiet origin "$DEFAULT_BRANCH"
    else
        git fetch origin "$DEFAULT_BRANCH"
    fi
    # Get the latest commit hash from the default branch
    COMMIT_VERSION=$(git rev-parse "origin/$DEFAULT_BRANCH")
    if [ -z "$COMMIT_VERSION" ]; then
        print_error "Could not determine the latest commit for branch $DEFAULT_BRANCH."
        exit 1
    fi
    print_message "Using latest commit from $DEFAULT_BRANCH: $COMMIT_VERSION"
fi

# Verify the commit/ref exists before checkout
if ! git rev-parse --quiet --verify "$COMMIT_VERSION^{commit}" >/dev/null; then
    print_error "Failed to verify commit/ref: $COMMIT_VERSION"
    exit 1
fi

# Checkout the determined version
print_message "Checking out version: $COMMIT_VERSION"
if [ "$SILENT" = true ]; then
    git checkout --quiet "$COMMIT_VERSION"
else
    git checkout "$COMMIT_VERSION"
fi
if [ $? -ne 0 ]; then
    print_error "Failed to checkout commit/ref $COMMIT_VERSION"
    exit 1
fi

# Get a version tag for the build (use commit hash as fallback)
# Try different approaches to get a meaningful version identifier:
# 1. First try exact tag match for the commit
# 2. Then try to find the closest tag with git describe
# 3. Fall back to the commit hash if no tags exist
CHECKED_OUT_VERSION=$(git describe --tags --exact-match 2>/dev/null || 
                      git describe --tags --always 2>/dev/null || 
                      git rev-parse --short HEAD)
print_message "Using version identifier for build: $CHECKED_OUT_VERSION"

# Perform go build
OUTPUT_BINARY="${PROVIDER_NAME}_${CHECKED_OUT_VERSION}"
print_message "Building binary: $OUTPUT_BINARY"
if [ "$SILENT" = true ]; then
    go build -o "$OUTPUT_BINARY" >/dev/null 2>&1 || {
        print_error "Go build failed. Check for build errors with: go build -o $OUTPUT_BINARY -v"
        exit 1
    }
else
    go build -o "$OUTPUT_BINARY" || {
        print_error "Go build failed"
        exit 1
    }
fi
print_message "Build successful: $TEMP_DIR/$OUTPUT_BINARY"

# Function to get installation paths
get_installation_paths() {
    # Determines the correct installation path for the provider binary
    # $1: GOOS (operating system)
    # $2: GOARCH (processor architecture) 
    # $3: Organization name
    # $4: Provider type
    # $5: Version identifier
    # Returns: The full installation path for the binary
    local goos=$1
    local goarch=$2
    local org=$3
    local provider_type=$4 # Renamed from 'provider' for clarity
    local version=$5
    local base_path install_path version_no_prefix registry_host
    
    # Ensure we have valid OS and ARCH
    goos=${goos:-$(go env GOOS)}
    goarch=${goarch:-$(go env GOARCH)}
    
    # Remove 'v' prefix if present for path construction
    version_no_prefix=$(echo "$version" | sed 's/^v//')
    
    # Determine registry host based on flag
    if [ "$OPENTOFU_ONLY" = true ]; then
        registry_host="registry.opentofu.org"
    else
        registry_host="registry.terraform.io"
    fi
    
    # Construct the installation path
    base_path="$HOME/.terraform.d/plugins"
    install_path="${base_path}/${registry_host}/${org}/${provider_type}/${version_no_prefix}/${goos}_${goarch}"
    
    echo "$install_path"
}

# Get installation path using the checked out version identifier
GOOS=$(go env GOOS)
GOARCH=$(go env GOARCH)
INSTALL_PATH=$(get_installation_paths "$GOOS" "$GOARCH" "$ORGANIZATION" "$PROVIDER_TYPE" "$CHECKED_OUT_VERSION")

# Create directory and copy binary
print_message "Preparing installation directory: $INSTALL_PATH"
mkdir -p "$INSTALL_PATH"
if [ $? -ne 0 ]; then
    print_error "Failed to create installation directory: $INSTALL_PATH"
    exit 1
fi

print_message "Installing binary to: $INSTALL_PATH/$OUTPUT_BINARY"
cp "$OUTPUT_BINARY" "$INSTALL_PATH/"
if [ $? -ne 0 ]; then
    print_error "Failed to copy binary to $INSTALL_PATH"
    exit 1
fi
print_message "Binary successfully installed."

# Clean up the original binary from the temp build directory
rm "$OUTPUT_BINARY"

# Only print the configuration block if --print-configuration was provided
if [ "$PRINT_CONFIG" = true ]; then
    # Use the version identifier determined earlier (tag or commit hash)
    # Remove 'v' prefix if present for the configuration block
    VERSION_FOR_CONFIG=$(echo "$CHECKED_OUT_VERSION" | sed 's/^v//')
    
    # Determine registry host based on flag
    if [ "$OPENTOFU_ONLY" = true ]; then
        REGISTRY_SOURCE="${ORGANIZATION}/${PROVIDER_TYPE}" # OpenTofu uses implicit registry host
        CONFIG_TOOL_NAME="OpenTofu"
    else
        REGISTRY_SOURCE="registry.terraform.io/${ORGANIZATION}/${PROVIDER_TYPE}" # Terraform often needs explicit host
        CONFIG_TOOL_NAME="Terraform"
    fi

    if [ "$SILENT" = false ]; then
        echo # Add a newline for better formatting
        echo "To use this provider in your $CONFIG_TOOL_NAME configuration, add the following block:"
    fi
    # Use printf for potentially cleaner multi-line output
    printf "\nterraform {\n"
    printf "  required_providers {\n"
    printf "    %s = {\n" "$PROVIDER_TYPE"
    printf "      source  = \"%s\"\n" "$REGISTRY_SOURCE"
    printf "      version = \"%s\"\n" "$VERSION_FOR_CONFIG"
    printf "    }\n"
    printf "  }\n"
    printf "}\n\n"
fi

# Cleanup is handled by the trap
print_message "Operation completed successfully."